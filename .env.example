# Copy to .env and configure the public Supabase client values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Cloudflare Turnstile site key (public). For local testing you can use
# Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Umami Cloud website id (public). Leave empty to disable analytics locally.
VITE_UMAMI_WEBSITE_ID=
